header.header-common
  a.header-common-logo#logo-primary(href=path + '/' aria-label="LUVISTA - Trang chủ")
    img.image-common(src=imgCommonPC + 'logo.svg' alt="LUVISTA" width="250" height="60")
  nav.header-common-tools(aria-label="Tiện ích")
    a.header-common-tool(href="#" aria-label="Xem dự án 360 độ")
      span.header-tool-icon.is-view-360(aria-hidden="true")
      span 360°
    span.header-common-tool(href="#" aria-label="Liên hệ" data-modal-open)
      span.header-tool-icon.is-contact(aria-hidden="true")
    a.header-common-tool(href="tel:+84000000000" aria-label="Gọi điện")
      span.header-tool-icon.is-phone(aria-hidden="true")
    button.header-common-tool.header-common-lang(type="button" aria-label="Chọn ngôn ngữ")
      span VN
      span.header-tool-icon.is-chevron(aria-hidden="true")
    button.header-common-menu.js-click(type="button" aria-label="Mở menu" aria-controls="site-navigation" aria-expanded="false")
      span Menu
      span.is-menu(aria-hidden="true")
  .header-common-navigation#site-navigation(role="dialog" aria-modal="true" aria-label="Menu chính" inert data-lenis-prevent)
    .navigation-wrapper
      //- img.navigation-wave(src=imgCommonPC + 'menu-wave.png' alt="" aria-hidden="true")
      canvas.navigation-wave(data-wave-src=imgCommonPC + 'menu-wave.svg' aria-hidden="true")
      a.navigation-brand(href=path + '/#section-home' aria-label="LUVISTA - Trang chủ")
        img(src=imgCommonPC + 'menu-logo.svg' alt="LUVISTA" width="459" height="110")
      .menu-heading
        button.button-close.js-button-close(type="button" aria-label="Đóng menu")
          span MENU
          span.button-icon
            svg(width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true")
              path(d="M0.5 0.5L16.299 16.299" stroke="currentColor" stroke-linecap="round")
              path(d="M0.5 16.2991L16.299 0.500099" stroke="currentColor" stroke-linecap="round")
      .navigation-content
        nav.navigation-menu(aria-label="Điều hướng chính")
          - var menuLinks = [{label: 'Trang chủ', target: ''}, {label: 'Giới thiệu', target: 'overview'}, {label: 'Vị trí', target: 'location'}, {label: 'Mặt bằng', target: 'masterplan'}, {label: 'Tiện ích', target: 'utilities'}, {label: 'Thư viện', target: 'gallery'}, {label: 'Tin tức', target: 'news'}, {label: 'Liên hệ', target: 'contact'}]
          ul.menu.main-menu.header-menu#main-menu
            each item in menuLinks
              li.menu-item.menu-link
                a.link-wrapper.item-link(href=path + '/' + item.target)
                  span.item-link-text= item.label
        .navigation-footer
          a.navigation-hotline(href="tel:0888790288")
            img(src=imgCommonPC + 'menu-phone.svg' alt="" width="32" height="32")
            span Hotline: #[strong 0888 790 288]
          .navigation-socials(aria-label="Mạng xã hội")
            each social in ['Facebook', 'Youtube', 'Tiktok', 'Zalo']
              a.header-icon(href="#" aria-label=social)
                img(src=imgCommonPC + 'menu-' + social.toLowerCase() + '.svg' alt="" width="34" height="34")
    .overlay-menu
  .modal-overlay.js-modal-overlay
    .popup-form#popupForm
      .popup-form__image
        img(src=imgCommonPC+"form_bg.jpeg" width="1920" height="1080" loading="eager" alt="form bg")
      .popup-form__content
        button.popup-form__close(type="button" aria-label="Đóng popup").
        .popup-form__inner
          h2.popup-form__title.
            ĐĂNG KÝ TƯ VẤN
          p.popup-form__desc.
            Quý khách vui lòng để lại thông tin, đội ngũ chuyên viên sẽ liên hệ tư vấn trong thời gian sớm nhất
          form.popup-form__form
            .form-group
              input(type="text" name="fullname" placeholder="Họ tên (*)", required)
            .form-group
              input(type="email" name="email" placeholder="Email")
            .form-group
              input(type="tel" name="phone" placeholder="Điện thoại (*)", required)
            .form-action
              button.form-submit(type="submit") LIÊN HỆ NGAY
