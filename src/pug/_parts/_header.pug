header.header-common
  a.header-common-logo#logo-primary(href=path + '/' aria-label="LUVISTA - Trang chủ")
    img.image-common(src=imgCommonPC + 'logo.svg' alt="LUVISTA" width="250" height="60")
  nav.header-common-tools(aria-label="Tiện ích")
    a.header-common-tool(href="#" aria-label="Xem dự án 360 độ")
      img.image-common.is-view-360(src=imgCommonPC + 'view-360.svg' alt="" width="14" height="14")
      span 360°
    a.header-common-tool(href="#" aria-label="Liên hệ")
      img.image-common.is-contact(src=imgCommonPC + 'contact.svg' alt="" width="21" height="23")
    a.header-common-tool(href="tel:+84000000000" aria-label="Gọi điện")
      img.image-common.is-phone(src=imgCommonPC + 'phone.svg' alt="" width="12" height="18")
    button.header-common-tool.header-common-lang(type="button" aria-label="Chọn ngôn ngữ")
      span VN
      img.image-common.is-chevron(src=imgCommonPC + 'chevron.svg' alt="" width="10" height="7")
    button.header-common-menu.js-click(type="button" aria-label="Mở menu")
      span Menu
      img.image-common.is-menu(src=imgCommonPC + 'menu.svg' alt="" width="23" height="23")
  .header-common-navigation
    .navigation-wrapper
      nav.navigation-menu
        .menu-heading
          button.button-close.js-button-close.trans(type="button")
            span MENU
            span.button-icon
              svg(width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg")
                path(d="M0.5 0.5L16.299 16.299" stroke="white" stroke-linecap="round")
                path(d="M0.5 16.2991L16.299 0.500099" stroke="white" stroke-linecap="round")
        ul.menu.main-menu.header-menu#main-menu.header-menu
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/")
              span.item-link-text trang chủ
              span.item-link-text-clone trang chủ
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/introduction/")
              span.item-link-text Giới thiệu
              span.item-link-text-clone Giới thiệu
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/projects/")
              span.item-link-text Dự án
              span.item-link-text-clone Dự án
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/gallery/")
              span.item-link-text Thư viện
              span.item-link-text-clone Thư viện
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/recruitment/")
              span.item-link-text Tuyển dụng
              span.item-link-text-clone Tuyển dụng
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/news/")
              span.item-link-text Tin tức
              span.item-link-text-clone Tin tức
          li.menu-item.menu-link
            a.link-wrapper.item-link.trans(href=path+"/contact/")
              span.item-link-text Liên hệ
              span.item-link-text-clone Liên hệ
    .overlay-menu
