section.panel.section-top-about.js-bg(id=page === 'overview' ? 'section-core-values' : 'section-about' aria-labelledby="about-title")
  .group-central
    .inner
      .group-bg.about-scene
        .about-art
          img.about-background(src=imgCommonPC + 'about-bg.jpg' width="1920" height="1080" alt="" aria-hidden="true")
          canvas.about-artwork-wave(data-wave-src=imgCommonPC + 'about-wave.svg' aria-hidden="true")
          svg.about-artwork(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" preserveAspectRatio="none" aria-hidden="true" focusable="false")
            image.about-artwork-ring-piece.is-two(href=imgCommonPC + 'about-ring-sector-02.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
            image.about-artwork-ring-piece.is-three(href=imgCommonPC + 'about-ring-sector-03.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
            image.about-artwork-ring-piece.is-four(href=imgCommonPC + 'about-ring-sector-04.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
            image.about-artwork-ring-front(href=imgCommonPC + 'about-ring-sector-01.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
            image.about-artwork-tower(href=imgCommonPC + 'about-towers.png' x="564.17" y="373" width="1092.78" height="615.02" preserveAspectRatio="none")
            image.about-artwork-ring-piece.is-five(href=imgCommonPC + 'about-ring-sector-05.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
          .about-copy-layer
            .about-heading#about-title.js-title
              span.about-heading-number 05
              h2 Giá trị #[br] trụ cột
            - var aboutValues = [{number: '01', text: 'Quỹ đất vàng <strong>cuối cùng</strong> của Phường nội đô Quy Nhơn Nam', position: 'is-one'}, {number: '02', text: 'Địa thế <strong>tựa sơn, hướng hải</strong> lưng tựa núi vững chãi, mặt hướng biển xanh đón trọn vượng khí.', position: 'is-two'}, {number: '03', text: 'Tiện ích cao cấp với Triết lý sống <strong>Urban Wellness</strong> cân bằng, viên mãn ngay giữa lòng đô thị', position: 'is-three'}, {number: '04', text: 'Pháp lý <strong>minh bạch – Sở hữu lâu dài – Sổ hồng</strong> từng căn', position: 'is-four'}, {number: '05', text: 'Chủ đầu tư có tiềm lực tài chính mạnh mẽ, cam kết về tiến độ và chất lượng vượt trội', position: 'is-five'}]
            .about-values.js-title.hero-sub
              each item in aboutValues
                article.about-value(class=item.position)
                  span.about-value-number= item.number
                  p!= item.text
