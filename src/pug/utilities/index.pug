extends ../_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn | Tiện ích'
  - var path = '..'
  - var page = 'utilities'
  - var imgPC = path + '/resources/images/utilities/'
  - var imgSP = path + '/resources/images/utilities/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  main.home
    .slider-stage
      section.panel.section-top-amenities.amenities#section-amenities(aria-label="Tiện ích dự án")
        .group-central
          .inner
            .group-bg.amenities-frame.js-inner-tabs
              - var externalAmenities = ['Công viên trung tâm', 'Phố thương mại', 'Nhà mẫu<br>Nhà sinh hoạt cộng đồng', 'Sân Pickleball', 'Công viên', 'Đường dạo bộ ven hồ', 'Hồ cảnh quan']
              - var internalAmenities = ['Vườn nghệ thuật', 'Đường dạo bộ trên cao', 'Khu vườn Hoàng Hôn', 'Vườn Trị liệu và Thiền định', 'Sân tập Yoga và Thái cực quyền', 'Khu đọc sách ngoài trời', 'Bãi đỗ trực thăng', 'Vườn rau hữu cơ', 'Phòng tập Gym', 'Phòng sinh hoạt cộng đồng', 'Hồ bơi', 'Phòng thay đồ', 'Ghế tắm nắng', 'Hồ cảnh quan', 'Vườn xanh', 'Sân tập dưỡng sinh', 'Khu sinh hoạt cộng đồng (ngoài trời)', 'Khu vui chơi trẻ em', 'Công viên thú cưng', 'Khu BBQ ngoài trời', 'Lối vào quảng trường chính', 'BBQ gia đình', 'Sân khấu ngoài trời', 'Hồ bơi trung tâm', 'Sen tắm đứng ngoài trời', 'Bể Jacuzzi', 'Ghế tắm nắng', 'Hồ bơi lưng núi', 'Khu thay đồ', 'Sân chơi cát', 'Sân khấu trình diễn', 'Cigar Lounge', 'Quầy Bar', 'Sân chơi trẻ em', 'Hồ thư giãn', 'Hồ bơi lưng núi', 'Ghế tắm nắng', 'Không gian tập gym', 'Phòng tập Yoga/Pilates', 'Phòng đọc sách']
              //- All three tabs share the overview content for this demo.
              - var amenitiesTabs = [{id: 'amenities-overview', title: 'Tiện ích tổng thể'}, {id: 'amenities-floor-1', title: 'Tiện ích tầng 1'}, {id: 'amenities-floor-2', title: 'Tiện ích tầng 2'}].map(function(tab) { return Object.assign(tab, {map: 'amenities-map.jpg', overlay: 'amenities-overlay.svg', external: externalAmenities, internal: internalAmenities}); })
              h1.title-common-primary.is-gold.js-title.hero-title Tiện ích dự án
              .amenities-tabs(role="tablist" aria-label="Mặt bằng tiện ích")
                each tab, index in amenitiesTabs
                  button.amenities-tab.inner-tab-btn(type="button" id=tab.id + '-tab' class=index === 0 ? 'active' : '' data-tab=tab.id role="tab" aria-controls=tab.id aria-selected=index === 0 ? 'true' : 'false' tabindex=index === 0 ? '0' : '-1')
                    span= tab.title
              each tab, index in amenitiesTabs
                .amenities-panel.inner-tab-panel(id=tab.id class=index === 0 ? 'active' : '' role="tabpanel" aria-labelledby=tab.id + '-tab' tabindex="0")
                  if tab.map
                    .amenities-map
                      img.object-common(src=imgPC + tab.map width="1920" height="1080" alt=tab.title + ' dự án LUVISTA' loading=index === 0 ? 'eager' : 'lazy' decoding="async")
                      img.amenities-overlay.js-inline-svg(src=imgPC + tab.overlay width="1920" height="1080" alt="Các vị trí và tên tháp tiện ích")
                  .amenities-wrapper
                    aside.amenities-legend
                      if tab.map
                        .amenities-legend-group.is-external
                          button.amenities-toggle(type="button" aria-expanded="false" aria-controls=tab.id + "-external") Tiện ích cảnh quan ngoại khu
                            img(src=imgPC + 'amenities-chevron.svg' width="19" height="19" alt="")
                          button.amenities-close(type="button" aria-label="Đóng tiện ích cảnh quan ngoại khu") ×
                          .amenities-columns.is-external-columns(id=tab.id + "-external")
                            ol
                              each item, index in tab.external.slice(0, 3)
                                li
                                  span= ('0' + (index + 1)).slice(-2)
                                  p!= item
                            ol(start="4")
                              each item, index in tab.external.slice(3)
                                li
                                  span= ('0' + (index + 4)).slice(-2)
                                  p!= item
                        .amenities-legend-group.is-internal
                          button.amenities-toggle(type="button" aria-expanded="false" aria-controls=tab.id + "-internal") Tiện ích bên trong dự án
                            img(src=imgPC + 'amenities-chevron.svg' width="19" height="19" alt="")
                          button.amenities-close(type="button" aria-label="Đóng tiện ích bên trong dự án") ×
                          .amenities-columns(id=tab.id + "-internal")
                            ol
                              each item, index in tab.internal.slice(0, 10)
                                li
                                  span= ('0' + (index + 1)).slice(-2)
                                  p= item
                            ol(start="11")
                              each item, index in tab.internal.slice(10, 20)
                                li
                                  span= index + 11
                                  p= item
                            ol(start="21")
                              each item, index in tab.internal.slice(20, 30)
                                li
                                  span= index + 21
                                  p= item
                            ol(start="31")
                              each item, index in tab.internal.slice(30)
                                li
                                  span= index + 31
                                  p= item
      section.panel.section-utilities-pool.pool#section-pool(aria-label="HỒ BƠI OZONE")
        .group-central
          .inner
            .group-bg
              .pool-image
                img.object-common(src=imgPC+"pool-bg.jpg" width="1920" height="1080" alt="HỒ BƠI OZONE" loading="eager")
              .pool-content
                h2.title-common-primary.no-icon.is-gold.js-title.hero-title HỒ BƠI OZONE
                .paragraph-common.js-title.hero-sub
                  p Hồ bơi sử dụng Ozone khử trùng mạnh mẽ thay thế Clo. Công nghệ này bảo vệ da, tóc, không gây kích ứng mắt hay mùi nồng. Nước giàu oxy giúp lưu thông máu, tái tạo năng lượng, mang lại trải nghiệm nghỉ dưỡng thuần khiết và tuyệt đối an toàn cho sức khỏe người sử dụng.
      section.panel.section-footer-common#section-contact(aria-labelledby="footer-consultation-title")
        .group-central
          .inner
            .group-bg
              .footer-wave-decoration
                canvas.footer-wave(data-wave-src=imgCommonPC + 'footer-wave.svg' data-wave-edge="top" data-wave-amplitude="0.1" aria-hidden="true")
              .wrapper
                .section-footer-common-consultation
                  .section-footer-common-heading
                    h2.title-common-primary.is-gold Đăng ký tư vấn
                  p.section-footer-common-intro Quý khách vui lòng để lại thông tin, đội ngũ chuyên viên sẽ liên hệ tư vấn trong thời gian sớm nhất.
                  form.section-footer-common-form(action="" method="post")
                    label
                      input(type="text" name="name" required placeholder="Họ tên (*)")
                    label
                      input(type="tel" name="phone" required placeholder="Số điện thoại (*)")
                    label
                      input(type="email" name="email" placeholder="Email")
                    label
                      select(name="unitType" aria-label="Chọn loại căn hộ bạn quan tâm")
                        option(value="" selected) Chọn loại căn hộ bạn quan tâm
                        option(value="studio") Căn hộ Studio
                        option(value="1pn_plus") Căn hộ 1 phòng ngủ + 1
                        option(value="2pn") Căn hộ 2 phòng ngủ
                        option(value="3pn") Căn hộ 3 phòng ngủ
                    label
                      textarea(name="message" rows="1" placeholder="Nội dung")
                    button.trans(type="submit")
                      span.section-footer-common-button-label Liên hệ ngay
                .section-footer-common-contact
                  h2.title-common-primary.is-gold.no-icon Thông tin liên hệ
                  - var footerContacts = [{icon: 'footer-location.svg', title: 'Sales Office', detail: 'Tòa nhà Repubulic Plaza Cộng Hòa, 18E Cộng Hòa, Phường Tân Sơn Nhất, TP.HCM'}, {icon: 'footer-location.svg', title: 'Sales Gallery', detail: 'Đường Chế Lan Viên, Phường Quy Nhơn Nam, Tỉnh Gia Lai'}, {icon: 'footer-phone.svg', title: 'Hotline', detail: '0888 790 288', href: 'tel:0888790288'}, {icon: 'footer-email.svg', title: 'Email', detail: 'info@luvista.vn', href: 'mailto:info@luvista.vn'}]
                  .section-footer-common-contact-list
                    each item in footerContacts
                      .section-footer-common-contact-item
                        img(src=imgCommonPC + item.icon width="34" height="34" alt="")
                        h3= item.title
                        if item.href
                          p
                            a.footer-contact-link.trans(href=item.href)= item.detail
                        else
                          p= item.detail
                  .section-footer-common-bottom
                    p © 2026 Luvista · Website by <a href="https://leaddigital.vn/" target="_blank" class="trans">Lead Digital</a>. <a class="section-footer-common-policy trans" href="#">Chính sách bảo mật thông tin cá nhân</a>
                    .section-footer-common-social
                      a.trans(href="#" aria-label="Facebook")
                        img.object-common(src=imgCommonPC + 'footer-facebook.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Youtube")
                        img.object-common(src=imgCommonPC + 'footer-youtube.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Tiktok")
                        img.object-common(src=imgCommonPC + 'footer-tiktok.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Zalo")
                        img.object-common(src=imgCommonPC + 'footer-zalo.svg' width="34" height="34" alt="")
                  p.section-footer-common-note Lưu ý: Chúng tôi đã nỗ lực và cẩn trọng để hoàn thiện tài liệu này. Tuy nhiên tài liệu chỉ dùng với mục đích tham khảo. Hình ảnh, sơ đồ kỹ thuật, bố trí nội ngoại thất hay thông tin mô tả về dự án chỉ nhằm mục đích minh họa, không phải là thông tin hiện thực hay cam kết pháp lý. Thông tin chính thức về dự án (bao gồm nhưng không giới hạn: tên tòa, thông tin căn hộ, diện tích, tiện ích…) sẽ được căn cứ trên hợp đồng mua bán và các tài liệu được thỏa thuận, ký kết chính thức với khách hàng.
                a.section-footer-common-go-top.js-button-top.trans(href="#section-home" aria-label="Về đầu trang")
                  img.object-common.js-inline-svg(src=imgCommonPC + 'footer-go-top.svg' width="50" height="50" alt="" loading="eager")
