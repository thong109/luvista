extends ../_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn | Tin tức'
  - var path = '..'
  - var page = 'news'
  - var imgPC = path + '/resources/images/news/'
  - var imgSP = path + '/resources/images/news/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  main.home
    section.section-news
      .wrapper
        h1.title-common-primary.is-gold Tin tức
        .js-inner-tabs
          ul.inner-tab-list
            li
              button.inner-tab-btn.active(type="button" data-tab="inner-tab-01")
                span tin dự án
            li
              button.inner-tab-btn(type="button" data-tab="inner-tab-02")
                span Tin thị trường
          - var newsItems = [{image: 'news-01.png', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-02.png', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-03.png', alt: 'Quảng trường và tiện ích LUVISTA'},{image: 'news-04.jpg', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-05.jpg', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-06.jpg', alt: 'Quảng trường và tiện ích LUVISTA'},{image: 'news-07.jpg', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-08.jpg', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-09.jpg', alt: 'Quảng trường và tiện ích LUVISTA'}]
          .inner-tab-content
            #inner-tab-01.inner-tab-panel.active
              .list-common-news
                each item in newsItems
                  article.news-item
                    a.news-link(href=path+"/news/detail/")
                      .news-image
                        img.object-common(src=imgCommonPC + item.image width="506" height="334" alt=item.alt loading="eager")
                      .news-content
                        time.news-date(datetime="2025-12-29" aria-label="Ngày 29 tháng 12 năm 2025")
                          span.news-day 29
                          span.news-month 12/2025
                        .news-summary
                          p.news-title Tận hưởng cuộc sống ngay lập tức và “đón lõng” những sóng phát triển dồn dập ngày mai, dự án là điểm đến cân bằng hoàn hảo mọi yếu tố để chủ nhân
                          span.news-more
                            span Xem chi tiết
                            img(src=imgCommonPC + 'news-detail-arrow.svg' width="14" height="10" alt="")
              .pagination-common
                ol.pagination-wrapper
                  li.pagination-news
                    span.pagination-news-wrapper.is-active 1
                  li.pagination-news
                    a.pagination-news-wrapper(href="#") 2
                  li.pagination-news
                    a.pagination-news-wrapper(href="#") 3
            #inner-tab-02.inner-tab-panel
              .list-common-news
                each item in newsItems
                  article.news-item
                    a.news-link(href=path+"/news/detail/")
                      .news-image
                        img.object-common(src=imgCommonPC + item.image width="506" height="334" alt=item.alt loading="eager")
                      .news-content
                        time.news-date(datetime="2025-12-29" aria-label="Ngày 29 tháng 12 năm 2025")
                          span.news-day 29
                          span.news-month 12/2025
                        .news-summary
                          p.news-title Tận hưởng cuộc sống ngay lập tức và “đón lõng” những sóng phát triển dồn dập ngày mai, dự án là điểm đến cân bằng hoàn hảo mọi yếu tố để chủ nhân
                          span.news-more
                            span Xem chi tiết
                            img(src=imgCommonPC + 'news-detail-arrow.svg' width="14" height="10" alt="")
              .pagination-common
                ol.pagination-wrapper
                  li.pagination-news
                    span.pagination-news-wrapper.is-active 1
                  li.pagination-news
                    a.pagination-news-wrapper(href="#") 2
                  li.pagination-news
                    a.pagination-news-wrapper(href="#") 3
    include ../_parts/_footer-section.pug
