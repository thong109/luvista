extends ../_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn | Mặt bằng'
  - var path = '..'
  - var page = 'masterplan'
  - var imgPC = path + '/resources/images/masterplan/'
  - var imgSP = path + '/resources/images/masterplan/'
  - var imgTop = path + '/resources/images/top/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  template#masterplan-studio-detail
    section.apartment-detail(aria-label="Mặt bằng căn hộ Studio")
      .article-wave(aria-hidden="true")
        canvas.regional-wave(data-wave-src=imgPC + 'article-wave.svg' aria-hidden="true")
      img.apartment-detail-compass(src=imgPC + 'compass.svg' width="140" height="136" alt="La bàn: Bắc, Đông, Tây, Nam")
      .wrapper
        p.title-common-primary.is-gold Mặt bằng căn hộ
        .apartment-detail-wrapper
          .apartment-detail-info
            p.apartment-detail-towers Tháp: The Horizon
            p.apartment-detail-floor Tầng 5 ~ 20 (CH2)
            .apartment-box
              p.apartment-detail-title Căn hộ Studio
              dl
                each item in [{icon: 'apartment-area.svg', label: 'Diện tích thông thủy:', value: '46.37 – 47.42 m²'}, {icon: 'apartment-area-wall.svg', label: 'Diện tích tim tường:', value: '50.40 – 51.03 m²'}, {icon: 'apartment-living-room.svg', label: 'Phòng khách', value: '1'}, {icon: 'apartment-bedroom.svg', label: 'Phòng ngủ:', value: '1'}, {icon: 'apartment-bathroom.svg', label: 'Phòng tắm:', value: '1'}]
                  div
                    img(src=imgPC + item.icon width="26" height="26" alt="" aria-hidden="true")
                    dt= item.label
                    dd= item.value
          .apartment-detail-plan
            .swiper.js-apartment-slider
              .swiper-wrapper
                - var studioImages = [{src: imgPC + 'apartment-studio-01.png', alt: 'Mặt bằng căn hộ Studio'},{src: imgPC + 'apartment-studio-02.png', alt: 'Mặt bằng căn hộ Studio'}]
                each image in studioImages
                  .swiper-slide
                    .apartment-detail-image
                      img(src=image.src width="1560" height="1800" alt=image.alt)
              .apartment-detail-dots.swiper-pagination
  main.home
    .slider-stage
      section.panel.section-top-masterplan.masterplan#section-masterplan(aria-labelledby="masterplan-title")
        - const masterplanTowers = [{slug: 'the-harmony', name: 'The Harmony'}, {slug: 'the-hill', name: 'The Hill'}, {slug: 'the-horizon', name: 'The Horizon', stats: [['Số tầng', '23 tầng'], ['Tổng sản phẩm', '280 căn'], ['Diện tích căn hộ', '34.94 - 128,52m²']]}, {slug: 'the-heritage', name: 'The Heritage'}, {slug: 'the-heights', name: 'The Heights'}]
        .group-central
          .inner
            .group-bg
              picture.masterplan-picture
                source(media="(max-width: 767.98px)" srcset=imgTop + 'masterplan-bg-mo.jpg')
                img.object-common(src=imgTop + 'masterplan-bg.jpg' width="1920" height="1080" alt="Phối cảnh mặt bằng tổng thể LUVISTA" loading="eager")
              .masterplan-map(data-masterplan-url=path + '/masterplan/')
                img.masterplan-overlay.js-inline-svg(src=imgTop + 'masterplan-labels.svg' width="1920" height="1080" preserveAspectRatio="xMidYMid slice" alt="Các tháp LUVISTA")
                .masterplan-tooltips
                  each tower in masterplanTowers
                    article.masterplan-tooltip(data-tower-info=tower.slug aria-hidden="true" inert)
                      h3= tower.name
                      if tower.stats
                        dl
                          each stat in tower.stats
                            dt= stat[0] + ':'
                            dd= stat[1]
                      else
                        p Xem thông tin tháp
                      a.masterplan-tooltip-arrow(href=path + '/masterplan/?tower=' + tower.slug + '#section-masterplan-article' aria-label='Xem ' + tower.name)
              h2.title-common-primary.js-title#masterplan-title Mặt bằng dự án
              .masterplan-guide.js-title.hero-sub
                span.masterplan-guide-text Hover và click vào tháp để xem thông tin
                button.masterplan-guide-toggle(type="button" aria-expanded="false" aria-controls="masterplan-home-tower-options") Chọn tháp để xem thông tin
                ul.masterplan-tower-options#masterplan-home-tower-options(aria-label="Chọn tháp" hidden)
                  each tower in masterplanTowers
                    li
                      a(href=path + '/masterplan/?tower=' + tower.slug + '#section-masterplan-article')= tower.name
      section.panel.section-masterplan-article#section-masterplan-article(aria-label="Mặt bằng tầng căn hộ CH2" data-transition="simple")
        .group-central
          .inner
            .group-bg
              .article-wave(aria-hidden="true")
                canvas.regional-wave(data-wave-src=imgPC + 'article-wave.svg' aria-hidden="true")
              img.masterplan-background(src=imgPC + 'floor-background.jpg' width="1920" height="1080" alt="Background" aria-hidden="true")
              .masterplan-pickers
                .masterplan-tower-picker.masterplan-floor-picker.js-masterplan-tower.sm(data-lenis-prevent)
                  .masterplan-floor-select(role="combobox" tabindex="0" aria-label="Chọn tháp" aria-haspopup="listbox" aria-expanded="false" aria-controls="masterplan-article-towers")
                    span.floor-current The Horizon
                    img.floor-chevron(src=imgPC + 'floor-chevron-mo.svg' alt="" aria-hidden="true")
                  .masterplan-floor-options#masterplan-article-towers(role="listbox" aria-label="Tháp" hidden)
                    each tower in [{name: 'The Hill', value: 'the-hill'}, {name: 'The Horizon', value: 'the-horizon'}, {name: 'The Harmony', value: 'the-harmony'}]
                      .floor-option(id='article-' + tower.value role="option" aria-selected=tower.value === 'the-horizon' data-value=tower.value data-plan=imgPC + (tower.value === 'the-horizon' ? 'floor-horizon-mo.png' : 'floor-ch2.png'))= tower.name
                img.masterplan-picker-divider.sm(src=imgPC + 'floor-divider-mo.svg' alt="" aria-hidden="true")
                .masterplan-floor-picker.js-masterplan-floor(data-lenis-prevent)
                  .masterplan-floor-select(role="combobox" tabindex="0" aria-label="Chọn tầng căn hộ CH2" aria-haspopup="listbox" aria-expanded="false" aria-controls="masterplan-floor-options")
                    span.floor-current Tầng 5 ~ 20 (CH2)
                    img.floor-chevron.md(src=imgPC + 'floor-chevron.svg' width="18" height="15" alt="" aria-hidden="true")
                    img.floor-chevron.sm(src=imgPC + 'floor-chevron-mo.svg' alt="" aria-hidden="true")
                  .masterplan-floor-options#masterplan-floor-options(role="listbox" aria-label="Tầng căn hộ CH2" hidden)
                    .floor-option#floor-option-all(role="option" aria-selected="true" data-value="5-20" data-plan=imgPC + 'floor-ch2.png') Tầng 5 ~ 20 (CH2)
                    each floor in Array.from({length: 16}, (_, index) => index + 5)
                      .floor-option(id='floor-option-' + floor role="option" aria-selected="false" data-value=floor data-plan=imgPC + 'floor-ch2.png')= 'Tầng ' + floor + ' (CH2)'
              .masterplan-compass.md(role="img" aria-label="La bàn: Bắc, Đông, Tây, Nam")
                img.compass-rose(src=imgPC + 'compass.svg' alt="" aria-hidden="true")
              img.masterplan-compass-mobile.sm(src=imgPC + 'compass.svg' width="140" height="136" alt="La bàn: Bắc, Đông, Tây, Nam")
              .masterplan-road.sm
                p View vịnh Quy Nhơn
                strong ĐƯỜNG CHẾ LAN VIÊN
              .masterplan-mobile-plan.sm
                img#masterplan-mobile-floor-image(src=imgPC + 'floor-horizon-mo.png' width="636" height="634" alt="Mặt bằng tầng 5 đến 20 (CH2), tháp The Horizon" loading="eager")
              .masterplan-drawing-wrapper.md
                .masterplan-drawing-scroll(tabindex="0" aria-label="Sơ đồ mặt bằng; có thể cuộn ngang trên màn hình nhỏ")
                  .masterplan-drawing
                    img#masterplan-floor-image(src=imgPC + 'floor-ch2.png' width="1443" height="1002" alt="Mặt bằng tầng 5 đến 20 (CH2): The Horizon, The Harmony và The Hill" loading="eager" fetchpriority="high" decoding="async")
                    img(src=imgPC+"masterplan-diagram-02.svg" class="js-inline-svg" alt="Mặt bằng tổng thể")
                //- Demo areas; replace with approved apartment data.
                - var unitTypes = [{title: 'CH 3 PHÒNG NGỦ', label: '3 phòng ngủ', net: '90.00 – 95.00 m²', gross: '98.00 – 103.00 m²'}, {title: 'CH 2 PHÒNG NGỦ', label: '2 phòng ngủ', net: '65.70 – 68.65 m²', gross: '71.00 – 74.00 m²'}, {title: 'CH 1 PHÒNG NGỦ +1', label: '1 phòng ngủ +1', net: '45.91 – 48.90 m²', gross: '50.00 – 53.00 m²'}, {title: 'CH STUDIO', label: 'studio', net: '46.37 – 47.42 m²', gross: '50.40 – 51.03 m²'}]
                each unit, index in unitTypes
                  .masterplan-hover-box(id='masterplan-hover-type-' + (index + 1) data-unit-type=index + 1 role="tooltip")
                    svg.masterplan-hover-icon(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 34 17" aria-hidden="true" focusable="false")
                      path(d="M26.6236 16.1267L26.3495 17L24.5962 16.4518L24.8704 15.5786C24.9532 15.3236 26.4897 10.5429 30.3213 8.50319C26.5216 6.45707 24.9532 1.69554 24.8704 1.44057L24.5898 0.567307L26.3367 0.00637627L26.6172 0.879642C26.6363 0.949759 28.8422 7.59168 33.9936 7.59168V9.42745C28.7912 9.42745 26.6363 16.063 26.6172 16.1331" fill="#fff")
                      path(d="M33.9995 9.35059L4.27734 9.35059V7.64867L33.9995 7.64867V9.35059Z" fill="#fff")
                    .masterplan-hover-content
                      h3= unit.title
                      p DT thông thủy:
                        strong= unit.net
                      p DT tim tường:
                        strong= unit.gross
              p.masterplan-pan-hint Vuốt ngang để xem toàn bộ mặt bằng
              ul.masterplan-legend(aria-label="Chú giải loại căn hộ")
                each unit, index in unitTypes
                  li(class='is-type-' + (index + 1) data-unit-type=index + 1 tabindex="0" aria-describedby='masterplan-hover-type-' + (index + 1))
                    span.legend-swatch(aria-hidden="true")
                    span Căn hộ
                      br
                      = unit.label
      section.panel.section-footer-common#section-contact(aria-labelledby="footer-consultation-title")
        .group-central
          .inner
            .group-bg
              .footer-wave-decoration
                canvas.footer-wave(data-wave-src=imgCommonPC + 'footer-wave.svg' data-wave-edge="top" data-wave-amplitude="0.1" aria-hidden="true")
              .wrapper
                .section-footer-common-consultation
                  .section-footer-common-heading
                    h2.title-common-primary.is-gold Đăng ký tư vấn
                  p.section-footer-common-intro Quý khách vui lòng để lại thông tin, đội ngũ chuyên viên sẽ liên hệ tư vấn trong thời gian sớm nhất.
                  form.section-footer-common-form(action="" method="post")
                    label
                      input(type="text" name="name" required placeholder="Họ tên (*)")
                    label
                      input(type="tel" name="phone" required placeholder="Số điện thoại (*)")
                    label
                      input(type="email" name="email" placeholder="Email")
                    label
                      select(name="unitType" aria-label="Chọn loại căn hộ bạn quan tâm")
                        option(value="" selected) Chọn loại căn hộ bạn quan tâm
                        option(value="studio") Căn hộ Studio
                        option(value="1pn_plus") Căn hộ 1 phòng ngủ + 1
                        option(value="2pn") Căn hộ 2 phòng ngủ
                        option(value="3pn") Căn hộ 3 phòng ngủ
                    label
                      textarea(name="message" rows="1" placeholder="Nội dung")
                    button.trans(type="submit")
                      span.section-footer-common-button-label Liên hệ ngay
                .section-footer-common-contact
                  h2.title-common-primary.is-gold.no-icon Thông tin liên hệ
                  - var footerContacts = [{icon: 'footer-location.svg', title: 'Sales Office', detail: 'Tòa nhà Repubulic Plaza Cộng Hòa, 18E Cộng Hòa, Phường Tân Sơn Nhất, TP.HCM'}, {icon: 'footer-location.svg', title: 'Sales Gallery', detail: 'Đường Chế Lan Viên, Phường Quy Nhơn Nam, Tỉnh Gia Lai'}, {icon: 'footer-phone.svg', title: 'Hotline', detail: '0888 790 288', href: 'tel:0888790288'}, {icon: 'footer-email.svg', title: 'Email', detail: 'info@luvista.vn', href: 'mailto:info@luvista.vn'}]
                  .section-footer-common-contact-list
                    each item in footerContacts
                      .section-footer-common-contact-item
                        img(src=imgCommonPC + item.icon width="34" height="34" alt="")
                        h3= item.title
                        if item.href
                          p
                            a.footer-contact-link.trans(href=item.href)= item.detail
                        else
                          p= item.detail
                  .section-footer-common-bottom
                    p © 2026 Luvista · Website by <a href="https://leaddigital.vn/" target="_blank" class="trans">Lead Digital</a>. <a class="section-footer-common-policy trans" href="#">Chính sách bảo mật thông tin cá nhân</a>
                    .section-footer-common-social
                      a.trans(href="#" aria-label="Facebook")
                        img.object-common(src=imgCommonPC + 'footer-facebook.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Youtube")
                        img.object-common(src=imgCommonPC + 'footer-youtube.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Tiktok")
                        img.object-common(src=imgCommonPC + 'footer-tiktok.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Zalo")
                        img.object-common(src=imgCommonPC + 'footer-zalo.svg' width="34" height="34" alt="")
                  p.section-footer-common-note Lưu ý: Chúng tôi đã nỗ lực và cẩn trọng để hoàn thiện tài liệu này. Tuy nhiên tài liệu chỉ dùng với mục đích tham khảo. Hình ảnh, sơ đồ kỹ thuật, bố trí nội ngoại thất hay thông tin mô tả về dự án chỉ nhằm mục đích minh họa, không phải là thông tin hiện thực hay cam kết pháp lý. Thông tin chính thức về dự án (bao gồm nhưng không giới hạn: tên tòa, thông tin căn hộ, diện tích, tiện ích…) sẽ được căn cứ trên hợp đồng mua bán và các tài liệu được thỏa thuận, ký kết chính thức với khách hàng.
                a.section-footer-common-go-top.js-button-top.trans(href="#section-home" aria-label="Về đầu trang")
                  img.object-common.js-inline-svg(src=imgCommonPC + 'footer-go-top.svg' width="50" height="50" alt="" loading="eager")
