extends ./_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn'
  - var path = '.'
  - var page = 'top'
  - var imgPC = path + '/resources/images/top/'
  - var imgSP = path + '/resources/images/top/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  main.home
    .slider-stage
      section.panel.section-top-keyvisual.keyvisual#section-home(aria-labelledby="keyvisual-title")
        .group-central
          .inner
            .group-bg
              .keyvisual-media.swiper.js-slider-keyvisual
                .swiper-wrapper
                  .swiper-slide
                    picture.slider-image
                      source(media="(max-width: 1024px)" srcset=imgPC+"hero-mo.jpg")
                      img.js-preload.object-common(src=imgPC+"hero.jpg" alt="Phối cảnh dự án LUVISTA Quy Nhơn" width="1920" height="1080" loading="eager")
                  .swiper-slide
                    picture.slider-image
                      source(media="(max-width: 1024px)" srcset=imgPC+"hero-mo.jpg")
                      img.js-preload.object-common(src=imgPC+"hero.jpg" alt="Phối cảnh dự án LUVISTA Quy Nhơn" width="1920" height="1080" loading="eager")
              .keyvisual-title.js-title.hero-title
                img.keyvisual-star.is-one(src=imgPC + 'star-large.svg' alt="")
                h1.hidden LUVISTA Quy Nhơn
                img.image-common.keyvisual-slogan#keyvisual-title(src=imgPC + 'slogan.svg' alt="LUVISTA - Tuyệt tác sống bên vịnh biển" width="682" height="177")
              span.keyvisual-scroll(href="#section-overview" aria-label="Xem tổng quan dự án")
                svg.object-common(width="32" height="63" viewBox="-10 -10 52 82" fill="none")
                  path(d="M31.3535 46.5L15.8535 62L0.353515 46.5M15.8535 62L15.8535 -6.77527e-07" stroke="#163963")
                span Cuộn xuống
              img.keyvisual-star.is-two(src=imgPC + 'star-large.svg' alt="")
              img.keyvisual-star.is-three(src=imgPC + 'star-large.svg' alt="")
      section.panel.section-top-overview.overview.js-bg#section-overview(aria-labelledby="overview-title")
        .group-central
          .inner
            .group-bg
              img.overview-light(src=imgPC + 'overview-light.png' alt="")
              .wrapper
                h2.title-common-primary.js-title.hero-title Tổng quan
                .overview-location.js-title.hero-sub
                  span Vị trí
                  strong Đường Chế Lan Viên, Phường Quy Nhơn Nam, Tỉnh Gia Lai
                .overview-facts.js-title.hero-sub
                  - var facts = [{label: 'Quy mô', value: '8.3<span class="unit">ha</span>'}, {label: 'Số tòa tháp', value: '5<span class="unit">toà</span>'}, {label: 'tầng và 1 tầng hầm', value: '23'}, {label: 'Sản phẩm', value: '1,630'}, {label: 'Mật độ xây dựng', value: '50%'}, {label: 'Hình thức sở hữu', value: 'Dài lâu',small: true},{label: 'Bàn giao giai đoạn 1', value: 'Quý III/2028', small: true}]
                  each fact in facts
                    .overview-fact
                      strong(class=fact.small ? 'is-small' : '')!= fact.value
                      span= fact.label
      section.panel.section-top-location.location#section-location(aria-labelledby="location-title")
        .group-central
          .inner
            .group-bg
              .location-map(role="img" aria-label="Bản đồ vị trí LUVISTA và các tiện ích kết nối tại Quy Nhơn")
                img.location-background(src=imgPC + 'location-background.jpg' width="1920" height="1080" alt="")
                img(src=imgPC+"location-diagram-02.svg" class="js-inline-svg location-line" alt="Map")
                img.location-overlay.location-icons(src=imgPC + 'location-icons.svg' width="1920" height="1080" alt="")
                img.location-logo(src=imgPC + 'location-logo.svg' width="295" height="192" alt="")
                .location-glow
                  img(src=imgPC + 'location-glow.svg' alt="")
              .location-content
                h2.title-common-primary.is-gold#location-title.js-title.hero-title Vị trí dự án
                - var locationGroups = [{time: '02', places: ['Điểm du lịch Ghềnh Ráng - Tiên Sa', 'Bến xe Quy Nhơn', 'Chợ Ghềnh Ráng', 'MM Mega Market', 'Kim Cúc Plaza', 'GO Quy Nhơn', 'Rạp chiếu phim CGV']}, {time: '05', places: ['Coop Mart', 'Quảng trường Nguyễn Tất Thành', 'Bãi biển Quy Nhơn', 'Trung tâm Khám phá KH Quy Nhơn', 'ICISE Quy Nhơn', 'Công viên sáng tạo TMA']}, {time: '07', places: ['Trung tâm bảo hiểm Quy Nhơn', 'Bệnh viện', 'Sân vận động']}, {time: '10', places: ['Ga Quy Nhơn', 'Trường THPT Lê Quý Đôn']}, {time: '20', places: ['Ga Diêu Trì', 'Trung tâm AI Bình Định']}, {time: '30', places: ['Sân bay Phù Cát', 'Kỳ Co - Điểm du lịch Eo Gió']}]
                .location-navigation.js-title.hero-sub
                  button.location-arrow.is-prev(type="button" aria-label="Nhóm thời gian trước")
                    img(src=imgPC + 'location-prev.svg' width="39" height="39" alt="")
                  .location-tabs(role="tablist" aria-label="Thời gian di chuyển")
                    each group, index in locationGroups
                      button.location-tab(type="button" role="tab" id='location-tab-' + group.time aria-controls='location-panel-' + group.time aria-selected=index === 0 ? 'true' : 'false' tabindex=index === 0 ? '0' : '-1')
                        strong= group.time
                        span Phút
                  button.location-arrow.is-next(type="button" aria-label="Nhóm thời gian tiếp theo")
                    img(src=imgPC + 'location-next.svg' width="39" height="39" alt="")
                .location-panels.js-title.hero-sub
                  each group, index in locationGroups
                    .location-panel(role="tabpanel" id='location-panel-' + group.time aria-labelledby='location-tab-' + group.time hidden=index !== 0 tabindex="0")
                      p.location-time
                        strong= group.time
                        span Phút
                      ul
                        each place in group.places
                          li= place
      section.panel.section-top-amenities.amenities#section-amenities(aria-label="Tiện ích dự án")
        .group-central
          .inner
            .group-bg.amenities-frame
              .amenities-map
                img.object-common(src=imgPC + 'amenities-map.jpg' width="1920" height="1080" alt="Mặt bằng tổng thể tiện ích dự án LUVISTA" loading="eager" decoding="async")
                img.amenities-overlay.js-inline-svg(src=imgPC + 'amenities-overlay.svg' width="1920" height="1080" alt="Các vị trí và tên tháp tiện ích")
              .amenities-wrapper
                h2.title-common-primary.is-gold.js-title.hero-title Tiện ích dự án
                - var externalAmenities = ['Công viên trung tâm', 'Phố thương mại', 'Nhà mẫu<br>Nhà sinh hoạt cộng đồng', 'Sân Pickleball', 'Công viên', 'Đường dạo bộ ven hồ', 'Hồ cảnh quan']
                - var internalAmenities = ['Vườn nghệ thuật', 'Đường dạo bộ trên cao', 'Khu vườn Hoàng Hôn', 'Vườn Trị liệu và Thiền định', 'Sân tập Yoga và Thái cực quyền', 'Khu đọc sách ngoài trời', 'Bãi đỗ trực thăng', 'Vườn rau hữu cơ', 'Phòng tập Gym', 'Phòng sinh hoạt cộng đồng', 'Hồ bơi', 'Phòng thay đồ', 'Ghế tắm nắng', 'Hồ cảnh quan', 'Vườn xanh', 'Sân tập dưỡng sinh', 'Khu sinh hoạt cộng đồng (ngoài trời)', 'Khu vui chơi trẻ em', 'Công viên thú cưng', 'Khu BBQ ngoài trời', 'Lối vào quảng trường chính', 'BBQ gia đình', 'Sân khấu ngoài trời', 'Hồ bơi trung tâm', 'Sen tắm đứng ngoài trời', 'Bể Jacuzzi', 'Ghế tắm nắng', 'Hồ bơi lưng núi', 'Khu thay đồ', 'Sân chơi cát', 'Sân khấu trình diễn', 'Cigar Lounge', 'Quầy Bar', 'Sân chơi trẻ em', 'Hồ thư giãn', 'Hồ bơi lưng núi', 'Ghế tắm nắng', 'Không gian tập gym', 'Phòng tập Yoga/Pilates', 'Phòng đọc sách']
                aside.amenities-legend.js-title.hero-sub
                  .amenities-legend-group.is-external
                    button.amenities-toggle(type="button" aria-expanded="false" aria-controls="external-amenities") Tiện ích cảnh quan ngoại khu
                      img(src=imgPC + 'amenities-chevron.svg' width="19" height="19" alt="")
                    button.amenities-close(type="button" aria-label="Đóng tiện ích cảnh quan ngoại khu") ×
                    .amenities-columns.is-external-columns#external-amenities
                      ol
                        each item, index in externalAmenities.slice(0, 3)
                          li
                            span= ('0' + (index + 1)).slice(-2)
                            p!= item
                      ol(start="4")
                        each item, index in externalAmenities.slice(3)
                          li
                            span= ('0' + (index + 4)).slice(-2)
                            p!= item
                  .amenities-legend-group.is-internal
                    button.amenities-toggle(type="button" aria-expanded="false" aria-controls="internal-amenities") Tiện ích bên trong dự án
                      img(src=imgPC + 'amenities-chevron.svg' width="19" height="19" alt="")
                    button.amenities-close(type="button" aria-label="Đóng tiện ích bên trong dự án") ×
                    .amenities-columns#internal-amenities
                      ol
                        each item, index in internalAmenities.slice(0, 10)
                          li
                            span= ('0' + (index + 1)).slice(-2)
                            p= item
                      ol(start="11")
                        each item, index in internalAmenities.slice(10, 20)
                          li
                            span= index + 11
                            p= item
                      ol(start="21")
                        each item, index in internalAmenities.slice(20, 30)
                          li
                            span= index + 21
                            p= item
                      ol(start="31")
                        each item, index in internalAmenities.slice(30)
                          li
                            span= index + 31
                            p= item
      section.panel.section-top-masterplan.masterplan#section-masterplan(aria-labelledby="masterplan-title")
        .group-central
          .inner
            .group-bg
              picture.masterplan-picture
                source(media="(max-width: 767.98px)" srcset=imgPC+"masterplan-bg-mo.jpg")
                img.object-common(src=imgPC + 'masterplan-bg.jpg' width="1920" height="1080" alt="Mặt bằng tổng thể dự án LUVISTA" loading="eager")
              .masterplan-map
                img(src=imgPC+"masterplan-diagram.svg" class="js-inline-svg" alt="Mặt bằng tổng thể")
              h2.title-common-primary.js-title.hero-title Mặt bằng dự án
              .masterplan-guide.js-title.hero-title
                span Hover và click vào tháp để xem thông tin
      section.panel.section-top-project-gallery.project-gallery#section-project-gallery(aria-labelledby="project-gallery-title")
        .group-central
          .inner
            .group-bg
              img.project-gallery-line.is-top(src=imgPC + 'gallery-line-02.png' width="713" height="161" alt="")
              img.project-gallery-line.is-bottom(src=imgPC + 'gallery-line-01.png' width="692" height="161" alt="")
              .wrapper
                h2.title-common-primary.is-gold.js-title.hero-title Hình ảnh dự án
                - var projectGallery = [{url: imgPC + 'gallery-project-01.jpg', alt: 'Lối vào quảng trường chính', w: 1920, h: 1080}, {url: imgPC + 'gallery-project-02.jpg', alt: 'Hồ bơi lưng núi', w: 1920, h: 1080}]
                .project-gallery-slider.js-project-gallery.js-title.hero-sub
                  .swiper
                    .swiper-wrapper
                      each image, index in projectGallery.concat(projectGallery)
                        .swiper-slide
                          figure.project-gallery-item
                            button.project-gallery-image.js-slide-image(type="button" data-gallery=JSON.stringify(projectGallery) data-index=index % projectGallery.length data-title=image.alt aria-label='Xem ảnh: ' + image.alt)
                              img.object-common(src=image.url width=image.w height=image.h alt=image.alt loading="eager")
                            figcaption= image.alt
                  button.project-gallery-arrow.is-prev.trans(type="button" aria-label="Ảnh trước")
                    img(src=imgPC + 'gallery-arrow-prev.svg' width="51" height="34" alt="")
                  button.project-gallery-arrow.is-next.trans(type="button" aria-label="Ảnh tiếp theo")
                    img(src=imgPC + 'gallery-arrow-next.svg' width="51" height="34" alt="")
      section.panel.section-top-core-values.core-values#section-core-values(aria-labelledby="core-values-title")
        .group-central
          .inner
            .group-bg
              img.core-values-line.is-top(src=imgPC + 'values-line-01.png' width="880" height="161" alt="")
              img.core-values-line.is-bottom(src=imgPC + 'values-line-02.png' width="880" height="161" alt="")
              .wrapper
                h2.core-values-heading.js-title.hero-title
                  span 05
                  p.title-common-primary.is-gold Giá trị Trụ Cột
                - var coreValues = [{number: '01', text: 'Quỹ đất vàng <strong>cuối cùng</strong> của Phường nội đô Quy Nhơn Nam'}, {number: '02', text: 'Địa thế <strong>tựa sơn, hướng hải</strong> lưng tựa núi vững chãi, mặt hướng biển xanh đón trọn vượng khí.'}, {number: '03', text: 'Tiện ích cao cấp với Triết lý sống <strong>Urban Wellness</strong> cân bằng, viên mãn ngay giữa lòng đô thị'}, {number: '04', text: 'Pháp lý <strong>minh bạch – Sở hữu lâu dài – Sổ hồng</strong> từng căn'}, {number: '05', text: 'Chủ đầu tư có <strong>tiềm lực tài chính mạnh mẽ</strong>, cam kết về tiến độ và chất lượng vượt trội'}]
                .core-values-list.js-title.hero-sub
                  each item in coreValues
                    article.core-values-item
                      .core-values-number
                        img.object-common(src=imgPC + 'core-number-' + item.number + '.svg' width="179" height="129" alt!= item.number loading="eager")
                      p!= item.text
      section.panel.section-top-news.news#section-news(aria-labelledby="news-title")
        .group-central
          .inner
            .group-bg
              - var newsItems = [{image: 'news-01.png', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-02.png', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-03.png', alt: 'Quảng trường và tiện ích LUVISTA'},{image: 'news-01.png', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-02.png', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-03.png', alt: 'Quảng trường và tiện ích LUVISTA'}]
              .wrapper
                h2.title-common-primary.is-gold.js-title.hero-title Tin tức
                .news-list.js-news-slider.js-title.hero-sub
                  .swiper
                    .swiper-wrapper
                      each item in newsItems
                        .swiper-slide
                          article.news-item
                            a.news-link(href=path+"/news/detail/")
                              .news-image
                                img.object-common(src=imgCommonPC + item.image width="506" height="334" alt=item.alt loading="eager")
                              .news-content
                                time.news-date(datetime="2025-12-29" aria-label="Ngày 29 tháng 12 năm 2025")
                                  span.news-day 29
                                  span.news-month 12/2025
                                .news-summary
                                  p.news-title Tận hưởng cuộc sống ngay lập tức và “đón lõng” những sóng phát triển dồn dập ngày mai, dự án là điểm đến cân bằng hoàn hảo mọi yếu tố để chủ nhân
                                  span.news-more
                                    span Xem chi tiết
                                    img(src=imgCommonPC + 'news-detail-arrow.svg' width="14" height="10" alt="")
                  button.news-arrow.is-prev(type="button" aria-label="Tin trước")
                    img(src=imgPC + 'news-prev.svg' width="34" height="34" alt="")
                  button.news-arrow.is-next(type="button" aria-label="Tin tiếp theo")
                    img(src=imgPC + 'news-next.svg' width="34" height="34" alt="")
      section.panel.section-top-developer.developer#section-developer(aria-labelledby="developer-title")
        .group-central
          .inner
            .group-bg
              img.developer-background(src=imgPC + 'developer-bg.jpg' width="1920" height="1080" alt="" loading="eager")
              img.developer-top(src=imgPC + 'developer-top.png' width="1920" height="279" alt="")
              img.developer-arch(src=imgPC + 'developer-arch.svg' width="1370" height="764" alt="")
              img.developer-bottom(src=imgPC + 'developer-bottom.png' width="1920" height="198" alt="")
              img.developer-line(src=imgPC + 'developer-line.png' width="896" height="161" alt="")
              .developer-content
                h2.title-common-primary.is-gold.js-title.hero-title Chủ đầu tư
                .list-top-developer
                  .developer-logo-primary.js-title.hero-title
                    .logo-primary
                      img.image-common(src=imgPC + 'developer-tnt.svg' width="160" height="164" alt="TNT Homes Quy Nhơn")
                  .developer-partner.js-title.hero-title
                    p Đơn vị phát triển
                    .logo-partner.is-large
                      img.image-common(src=imgPC + 'developer-conasi.svg' width="241" height="121" alt="Conasi")
                  .developer-partner.js-title.hero-title
                    p Giải thưởng - chứng nhận
                    .logo-partner
                      img.image-common(src=imgPC + 'developer-award-logo.svg' width="219" height="90" alt="Edge")
      section.panel.section-footer-common#section-contact(aria-labelledby="footer-consultation-title")
        .group-central
          .inner
            .group-bg
              .wrapper
                .section-footer-common-consultation
                  .section-footer-common-heading
                    h2.title-common-primary.is-gold Đăng ký tư vấn
                  p.section-footer-common-intro Quý khách vui lòng để lại thông tin, đội ngũ chuyên viên sẽ liên hệ tư vấn trong thời gian sớm nhất.
                  form.section-footer-common-form(action="" method="post")
                    label
                      input(type="text" name="name" required placeholder="Họ tên (*)")
                    label
                      input(type="email" name="email" placeholder="Email")
                    label
                      input(type="tel" name="phone" required placeholder="Số điện thoại (*)")
                    button.trans(type="submit") Liên hệ ngay
                .section-footer-common-contact
                  h2.title-common-primary.is-gold.no-icon Thông tin liên hệ
                  - var footerContacts = [{icon: 'footer-location.svg', title: 'Sales Office', detail: 'Tòa nhà Repubulic Plaza Cộng Hòa, 18E Cộng Hòa, Phường Tân Sơn Nhất, TP.HCM'}, {icon: 'footer-location.svg', title: 'Sales Gallery', detail: 'Đường Chế Lan Viên, Phường Quy Nhơn Nam, Tỉnh Gia Lai'}, {icon: 'footer-phone.svg', title: 'Hotline', detail: '0888 790 288'}, {icon: 'footer-email.svg', title: 'Email', detail: 'info@luvista.vn'}]
                  .section-footer-common-contact-list
                    each item in footerContacts
                      .section-footer-common-contact-item
                        img(src=imgCommonPC + item.icon width="34" height="34" alt="")
                        h3= item.title
                        p= item.detail
                  .section-footer-common-bottom
                    p © 2026 Luvista · Website by <a href="https://leaddigital.vn/" target="_blank" class="trans">Lead Digital</a>
                    .section-footer-common-social
                      a.trans(href="#" aria-label="Facebook")
                        img.object-common(src=imgCommonPC + 'footer-facebook.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Youtube")
                        img.object-common(src=imgCommonPC + 'footer-youtube.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Tiktok")
                        img.object-common(src=imgCommonPC + 'footer-tiktok.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Zalo")
                        img.object-common(src=imgCommonPC + 'footer-zalo.svg' width="34" height="34" alt="")
                    .section-footer-common-policy
                      a.trans(href="#") Chính sách bảo mật thông tin cá nhân
                  p.section-footer-common-note Lưu ý: Chúng tôi đã nỗ lực và cẩn trọng để hoàn thiện tài liệu này. Tuy nhiên tài liệu chỉ dùng với mục đích tham khảo. Hình ảnh, sơ đồ kỹ thuật, bố trí nội ngoại thất hay thông tin mô tả về dự án chỉ nhằm mục đích minh họa, không phải là thông tin hiện thực hay cam kết pháp lý. Thông tin chính thức về dự án sẽ được căn cứ trên hợp đồng mua bán và các tài liệu được thỏa thuận, ký kết chính thức với khách hàng.
                a.section-footer-common-go-top.js-button-top.trans(href="#section-home" aria-label="Về đầu trang")
                  img.object-common.js-inline-svg(src=imgCommonPC + 'footer-go-top.svg' width="50" height="50" alt="" loading="eager")
