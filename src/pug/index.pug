extends ./_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn'
  - var path = '.'
  - var page = 'top'
  - var imgPC = path + '/resources/images/top/'
  - var imgSP = path + '/resources/images/top/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  main.home
    .slider-stage
      section.panel.section-top-keyvisual.keyvisual#section-home(aria-labelledby="keyvisual-title")
        .group-central
          .inner
            .group-bg
              .keyvisual-media.swiper.js-slider-keyvisual
                .swiper-wrapper
                  .swiper-slide
                    picture.slider-image
                      source(media="(max-width: 1024px)" srcset=imgPC+"hero-mo.jpg")
                      img.js-preload.object-common(src=imgPC+"hero.jpg" alt="Phối cảnh dự án LUVISTA Quy Nhơn" width="1920" height="1080" loading="eager")
                  .swiper-slide
                    picture.slider-image
                      source(media="(max-width: 1024px)" srcset=imgPC+"hero-mo.jpg")
                      img.js-preload.object-common(src=imgPC+"hero.jpg" alt="Phối cảnh dự án LUVISTA Quy Nhơn" width="1920" height="1080" loading="eager")
              span.keyvisual-scroll(href="#section-overview" aria-label="Xem tổng quan dự án")
                span Cuộn khám phá
                .scroll-icon
                  img.object-common(src=imgPC+"arrow-common.svg" alt="Cuộn xuống" width="21" height="42" loading="eager")
      section.panel.section-top-overview.overview#section-overview(aria-labelledby="overview-title")
        .group-central
          .inner
            .group-bg
              picture.overview-background
                source(media="(max-width: 1024px)" srcset=imgPC + 'overview-mo.jpg')
                img.object-common(src=imgPC + 'overview.jpg' width="1920" height="1080" alt="Phối cảnh LUVISTA Quy Nhơn")
              .overview-light(aria-hidden="true")
                canvas.overview-wave(data-wave-src=imgPC + 'overview-wave.svg' aria-hidden="true")
              .overview-content
                h2.overview-title.js-title Tổng quan Dự án
                p.overview-copy.js-reveal Luvista Quy Nhơn có không gian sống hiện đại, nơi kết hợp hài hòa giữa tiện nghi đô thị và nhịp sống thư thái của thành phố biển. Dự án hướng đến kiến tạo môi trường an cư chất lượng, đáp ứng nhu cầu sinh hoạt, nghỉ ngơi và tận hưởng cuộc sống của cư dân. Luvista mở ra tiềm năng trở thành lựa chọn đáng cân nhắc cho cả nhu cầu an cư lẫn đầu tư.
                - var overviewStats = [{value: '8.3', unit: 'ha', label: 'Quy mô'}, {value: '5', label: 'Số tòa tháp'}, {value: '23', label: 'tầng và 1 tầng hầm'}, {value: '1,630', label: 'Sản phẩm'}, {value: '50', unit: '%', label: 'Mật độ xây dựng'}, {value: 'Lâu dài', label: 'Hình thức sở hữu'}, {value: 'Quý III/2028', label: 'Bàn giao giai đoạn 1'}]
                dl.overview-stats
                  each stat, index in overviewStats
                    .overview-stat(class=index === 6 ? 'is-handover' : '')
                      dt.overview-label= stat.label
                      dd.overview-value
                        span= stat.value
                        if stat.unit
                          small= stat.unit
      section.panel.section-top-certificate.certificate.js-bg#section-certificate(aria-labelledby="certificate-title")
        .group-central
          .inner
            .group-bg
              .certificate-background
                img.object-common(src=imgPC + 'certificate-bg.jpg' width="1920" height="1080" alt="" aria-hidden="true")
              canvas.certificate-wave(data-wave-src=imgPC + 'certificate-wave.svg' aria-hidden="true")
              .certificate-glow(aria-hidden="true")
              .certificate-content
                h2.certificate-title#certificate-title.js-title
                  | Giải thưởng 
                  br
                  | quốc tế 
                  br
                  | danh giá
                .certificate-awards.js-title.hero-sub
                  .certificate-award.is-architecture
                    img.image-common(src=imgPC + 'certificate-img-01.jpg' width="159" height="372" alt="Giải thưởng Best Condo Architectural Design")
                  .certificate-award.is-development
                    img.image-common(src=imgPC + 'certificate-img-02.jpg' width="160" height="373" alt="Giải thưởng Best Integrated Development")
      section.panel.section-top-location.location#section-location(aria-labelledby="location-title")
        .group-central
          .inner
            .group-bg
              img.location-scene(src=imgPC + 'location-bg.jpg' width="1920" height="1080" alt="")
              .location-map(role="img" aria-label="Bản đồ vị trí LUVISTA và các tiện ích kết nối tại Quy Nhơn")
                img.location-background(src=imgPC + 'bg-map.png' width="1288" height="1080" alt="")
                img.location-line.js-inline-svg(src=imgPC + 'line-map.svg' width="1288" height="1080" alt="")
                img.location-icons.js-inline-svg(src=imgPC + 'icon-map-combined.svg' width="1288" height="1080" alt="")
              .location-wave-frame(aria-hidden="true")
                canvas.location-wave(data-wave-src=imgPC + 'location-wave.svg' aria-hidden="true")
              .location-content
                h2.location-title#location-title.js-title Vị trí cửa ngõ
                .location-copy.js-reveal
                  p Dự án tọa lạc tại cửa ngõ phía nam của phố biển Quy Nhơn. Đây cũng là cửa ngõ kết nối giao thông quan trọng nhất của Quy Nhơn khi liền kề Bến xe Trung tâm tỉnh Gia Lai, Quốc lộ 1D kết nối vào Miền Nam cũng như ra hướng Miền Bắc thông qua các tuyến Quốc lộ 1A hay Cao tốc Bắc Nam.
                  p Nằm mặt tiền đường Chế Lan Viên, dự án kết nối nhanh chóng tới các Trung tâm thương mại như Kim Cúc Plaza, Mega martket, rạp chiếu phim CGV, Khu du lịch Ghềnh Ráng – Tiên Sa, bãi tắm biển Quy Nhơn, Bệnh viện TW Quy Hòa…..và các điểm quan trọng khác của Trung tâm Quy Nhơn.
                a.location-more.js-after-reveal(href=path + '/location/')
                  span Xem thêm
                  span.location-more-arrow(aria-hidden="true")
                    span.location-more-ring
                      img(src=imgPC + 'location-more-ring.svg' width="39" height="39" alt="")
                      svg(viewBox="0 0 39 39" fill="none")
                        circle(cx="19.5" cy="19.5" r="19" stroke="currentColor")
      section.panel.section-top-amenities.amenities#section-amenities(aria-label="Tiện ích dự án")
        .group-central
          .inner
            .group-bg.amenities-frame
              .amenities-map
                img.object-common.is-active(src=imgPC + 'amenities-img-01.jpg' width="1920" height="1080" alt="Mặt bằng tiện ích Tầng 1 LUVISTA" data-amenities-floor="1" loading="eager" decoding="async")
                img.object-common(src=imgPC + 'amenities-img-02.jpg' width="1920" height="1080" alt="Mặt bằng tiện ích Tầng 4 LUVISTA" data-amenities-floor="4" loading="eager" decoding="async" aria-hidden="true")
                img.amenities-floor-overlay.js-inline-svg(src=imgPC + 'amenities-overlay-01.svg' data-overlay-floor="1" width="1920" height="1080" preserveAspectRatio="xMidYMid slice" alt="Các vị trí tiện ích Tầng 1")
                img.amenities-floor-overlay.js-inline-svg(src=imgPC + 'amenities-overlay-04.svg' data-overlay-floor="4" width="1920" height="1080" preserveAspectRatio="xMidYMid slice" alt="Các vị trí tiện ích Tầng 4")
              .amenities-wrapper
                h2.title-common-primary.is-gold.js-title Mặt bằng Tiện ích
                .amenities-floor-nav(role="tablist" aria-label="Tầng tiện ích")
                  button.amenities-floor.is-active#amenities-tab-1(type="button" role="tab" aria-selected="true" aria-controls="amenities-floor-1" data-floor="1") Tầng 1
                  button.amenities-floor#amenities-tab-4(type="button" role="tab" aria-selected="false" aria-controls="amenities-floor-4" tabindex="-1" data-floor="4") Tầng 4
                aside.amenities-legend#amenities-floor-1(role="tabpanel" aria-labelledby="amenities-tab-1" tabindex="0")
                  h3.amenities-legend-title Tiện ích tầng 1
                  - var floorOneAmenities = ['Lối vào quảng trường chính', 'BBQ gia đình', 'Sân khấu ngoài trời', 'Hồ bơi trung tâm', 'Sen tắm đứng ngoài trời', 'Bể Jacuzzi', 'Không gian tập Gym/Yoga/Pilates', 'Sảnh đón - The Harmony', 'Sảnh thang máy - The Harmony', 'Sảnh đón - The Hill', 'Sảnh thang máy - The Hill', 'Sảnh đón - The Horizon', 'Sảnh thang máy - The Horizon']
                  ol.amenities-floor-list
                    each item, index in floorOneAmenities
                      li(data-amenity=index + 1 tabindex="0")
                        span= ('0' + (index + 1)).slice(-2)
                        p= item
                aside.amenities-legend#amenities-floor-4(role="tabpanel" aria-labelledby="amenities-tab-4" tabindex="0" hidden)
                  h3.amenities-legend-title Tiện ích tầng 4
                  - var floorFourAmenities = ['Hồ bơi lưng núi', 'Khu thay đồ', 'Sân chơi cát', 'Sân chơi trẻ em', 'Hồ thư giãn', 'Sảnh thang máy - The Harmony', 'Sảnh thang máy - The Hill', 'Sảnh thang máy - The Horizon']
                  ol.amenities-floor-list
                    each item, index in floorFourAmenities
                      li(data-amenity=index + 14 tabindex="0")
                        span= index + 14
                        p= item
      section.panel.section-top-masterplan.masterplan#section-masterplan(aria-labelledby="masterplan-title")
        - const masterplanTowers = [{slug: 'the-harmony', name: 'The Harmony'}, {slug: 'the-hill', name: 'The Hill'}, {slug: 'the-horizon', name: 'The Horizon', stats: [['Số tầng', '23 tầng'], ['Tổng sản phẩm', '280 căn'], ['Diện tích căn hộ', '34.94 - 128,52m²']]}, {slug: 'the-heritage', name: 'The Heritage'}, {slug: 'the-heights', name: 'The Heights'}]
        .group-central
          .inner
            .group-bg
              picture.masterplan-picture
                source(media="(max-width: 767.98px)" srcset=imgPC + 'masterplan-bg-mo.jpg')
                img.object-common(src=imgPC + 'masterplan-bg.jpg' width="1920" height="1080" alt="Phối cảnh mặt bằng tổng thể LUVISTA" loading="eager")
              .masterplan-map(data-masterplan-url=path + '/masterplan/')
                img.masterplan-overlay.js-inline-svg(src=imgPC + 'masterplan-labels.svg' width="1920" height="1080" preserveAspectRatio="xMidYMid slice" alt="Các tháp LUVISTA")
                .masterplan-tooltips
                  each tower in masterplanTowers
                    article.masterplan-tooltip(data-tower-info=tower.slug aria-hidden="true" inert)
                      h3= tower.name
                      if tower.stats
                        dl
                          each stat in tower.stats
                            dt= stat[0] + ':'
                            dd= stat[1]
                      else
                        p Xem thông tin tháp
                      a.masterplan-tooltip-arrow(href=path + '/masterplan/?tower=' + tower.slug + '#section-masterplan-article' aria-label='Xem ' + tower.name)
              h2.title-common-primary.js-title#masterplan-title Mặt bằng dự án
              .masterplan-guide.js-title.hero-sub
                span.masterplan-guide-text Hover và click vào tháp để xem thông tin
                button.masterplan-guide-toggle(type="button" aria-expanded="false" aria-controls="masterplan-tower-options") Chọn tháp để xem thông tin
                ul.masterplan-tower-options#masterplan-tower-options(aria-label="Chọn tháp" hidden)
                  each tower in masterplanTowers
                    li
                      a(href=path + '/masterplan/?tower=' + tower.slug + '#section-masterplan-article')= tower.name
      section.panel.section-top-gallery.gallery#section-gallery
        .group-central
          .inner
            .group-bg
              canvas.gallery-wave(data-wave-src=imgPC + 'location-wave.svg' aria-hidden="true")
              h2.title-common-primary.is-gold.js-title Thư viện
              - const topGalleryTabs = [{id: 'overview', label: 'Tổng quan', images: [{url: imgPC + 'gallery-project-01.jpg', alt: 'Lối vào quảng trường chính'}, {url: imgPC + 'gallery-project-02.jpg', alt: 'Hồ bơi lưng núi'}, {url: imgPC + 'masterplan-bg.jpg', alt: 'Phối cảnh tổng thể'}]}, {id: 'studio', label: 'Căn hộ Studio', images: [{url: imgPC + 'gallery-project-01.jpg', alt: 'LUVISTA'}, {url: imgPC + 'gallery-project-02.jpg', alt: 'LUVISTA'}]}, {id: '1pn', label: 'Căn hộ 1PN', images: [{url: imgPC + 'gallery-project-01.jpg', alt: 'LUVISTA'}, {url: imgPC + 'gallery-project-02.jpg', alt: 'LUVISTA'}]}, {id: '2pn', label: 'Căn hộ 2PN', images: [{url: imgPC + 'gallery-project-01.jpg', alt: 'LUVISTA'}, {url: imgPC + 'gallery-project-02.jpg', alt: 'LUVISTA'}]}]
              .gallery-panels.js-title.hero-sub
                each tab, tabIndex in topGalleryTabs
                  .gallery-panel(id='top-gallery-panel-' + tab.id role="tabpanel" aria-labelledby='top-gallery-tab-' + tab.id aria-hidden=tabIndex ? 'true' : 'false' class=tabIndex ? '' : 'is-active' inert=tabIndex ? true : false)
                    .gallery-track.swiper
                      .swiper-wrapper
                        each image, index in tab.images
                          figure.gallery-item.swiper-slide(data-index=index)
                            button.gallery-image.js-slide-image(type="button" data-gallery=JSON.stringify(tab.images) data-index=index data-title=image.alt aria-label='Xem ảnh: ' + image.alt)
                              img(src=image.url width="666" height="420" alt=image.alt loading="eager" decoding="async")
                            figcaption= image.alt
                        if !tab.images.length
                          p.gallery-empty Hình ảnh đang được cập nhật
              .gallery-controls.js-title
                button.gallery-arrow.is-prev(type="button" aria-label="Ảnh trước")
                button.gallery-arrow.is-next(type="button" aria-label="Ảnh tiếp theo")
              .gallery-tabs.js-title(role="tablist" aria-label="Danh mục hình ảnh")
                each tab, tabIndex in topGalleryTabs
                  button.gallery-tab(id='top-gallery-tab-' + tab.id type="button" role="tab" aria-controls='top-gallery-panel-' + tab.id aria-selected=tabIndex ? 'false' : 'true' tabindex=tabIndex ? '-1' : '0' class=tabIndex ? '' : 'is-active')= tab.label
      //- section.panel.section-top-project-gallery.project-gallery#section-project-gallery(aria-labelledby="project-gallery-title")
      //-   .group-central
      //-     .inner
      //-       .group-bg
      //-         canvas.project-video-wave.is-top(data-wave-src=imgPC + 'video-wave-top.svg' aria-hidden="true")
      //-         canvas.project-video-wave.is-bottom(data-wave-src=imgPC + 'video-wave-bottom.svg' aria-hidden="true")
      //-         .wrapper
      //-           h2.title-common-primary.is-gold.js-title Hình ảnh dự án
      //-           - var projectGallery = [{url: imgPC + 'gallery-project-01.jpg', alt: 'Lối vào quảng trường chính', w: 1920, h: 1080}, {url: imgPC + 'gallery-project-02.jpg', alt: 'Hồ bơi lưng núi', w: 1920, h: 1080}]
      //-           .project-gallery-slider.js-project-gallery.js-title.hero-sub
      //-             .swiper
      //-               .swiper-wrapper
      //-                 each image, index in projectGallery.concat(projectGallery)
      //-                   .swiper-slide
      //-                     figure.project-gallery-item
      //-                       button.project-gallery-image.js-slide-image(type="button" data-gallery=JSON.stringify(projectGallery) data-index=index % projectGallery.length data-title=image.alt aria-label='Xem ảnh: ' + image.alt)
      //-                         img.object-common(src=image.url width=image.w height=image.h alt=image.alt loading="eager")
      //-                       figcaption= image.alt
      //-             button.project-gallery-arrow.is-prev.trans(type="button" aria-label="Ảnh trước")
      //-               img(src=imgPC + 'gallery-arrow-prev.svg' width="51" height="34" alt="")
      //-             button.project-gallery-arrow.is-next.trans(type="button" aria-label="Ảnh tiếp theo")
      //-               img(src=imgPC + 'gallery-arrow-next.svg' width="51" height="34" alt="")
      section.panel.section-top-about.js-bg#section-about(aria-labelledby="about-title")
        .group-central
          .inner
            .group-bg.about-scene
              .about-art
                img.about-background(src=imgPC + 'about-bg.jpg' width="1920" height="1080" alt="" aria-hidden="true")
                canvas.about-artwork-wave(data-wave-src=imgPC + 'about-wave.svg' aria-hidden="true")
                svg.about-artwork(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" preserveAspectRatio="none" aria-hidden="true" focusable="false")
                  image.about-artwork-ring-piece.is-two(href=imgPC + 'about-ring-sector-02.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
                  image.about-artwork-ring-piece.is-three(href=imgPC + 'about-ring-sector-03.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
                  image.about-artwork-ring-piece.is-four(href=imgPC + 'about-ring-sector-04.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
                  image.about-artwork-ring-front(href=imgPC + 'about-ring-sector-01.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
                  image.about-artwork-tower(href=imgPC + 'about-towers.png' x="564.17" y="373" width="1092.78" height="615.02" preserveAspectRatio="none")
                  image.about-artwork-ring-piece.is-five(href=imgPC + 'about-ring-sector-05.svg' x="0" y="0" width="1920" height="1080" preserveAspectRatio="none")
                .about-copy-layer
                  .about-heading#about-title.js-title
                    span.about-heading-number 05
                    h2 Giá trị #[br] trụ cột
                  - var aboutValues = [{number: '01', text: 'Quỹ đất vàng <strong>cuối cùng</strong> của Phường nội đô Quy Nhơn Nam', position: 'is-one'}, {number: '02', text: 'Địa thế <strong>tựa sơn, hướng hải</strong> lưng tựa núi vững chãi, mặt hướng biển xanh đón trọn vượng khí.', position: 'is-two'}, {number: '03', text: 'Tiện ích cao cấp với Triết lý sống <strong>Urban Wellness</strong> cân bằng, viên mãn ngay giữa lòng đô thị', position: 'is-three'}, {number: '04', text: 'Pháp lý <strong>minh bạch – Sở hữu lâu dài – Sổ hồng</strong> từng căn', position: 'is-four'}, {number: '05', text: 'Chủ đầu tư có tiềm lực tài chính mạnh mẽ, cam kết về tiến độ và chất lượng vượt trội', position: 'is-five'}]
                  .about-values.js-title.hero-sub
                    each item in aboutValues
                      article.about-value(class=item.position)
                        span.about-value-number= item.number
                        p!= item.text
      section.panel.section-top-news.news#section-news(aria-labelledby="news-title")
        .group-central
          .inner
            .group-bg
              canvas.news-wave(data-wave-src=imgPC + 'location-wave.svg' aria-hidden="true")
              - var newsItems = [{image: 'news-01.png', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-02.png', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-03.png', alt: 'Quảng trường và tiện ích LUVISTA'},{image: 'news-01.png', alt: 'Không gian thương mại và căn hộ LUVISTA'}, {image: 'news-02.png', alt: 'Hồ bơi và cảnh quan LUVISTA'}, {image: 'news-03.png', alt: 'Quảng trường và tiện ích LUVISTA'}]
              .wrapper
                h2.title-common-primary.is-gold.js-title#news-title Tin tức
                .news-list.js-news-slider.js-title.hero-sub
                  .swiper
                    .swiper-wrapper
                      each item in newsItems
                        .swiper-slide
                          article.news-item
                            a.news-link(href=path+"/news/detail/")
                              .news-image
                                img.object-common(src=imgCommonPC + item.image width="560" height="400" alt=item.alt loading="eager")
                              .news-content
                                time.news-date(datetime="2026-10-25" aria-label="Ngày 25 tháng 10 năm 2026")
                                  span.news-day 25
                                  span.news-month 10.2026
                                .news-summary
                                  p.news-title Tận hưởng cuộc sống ngay lập tức và “đón lõng” những sóng phát triển dồn dập ngày mai
                                  p.news-desc dự án là điểm đến cân bằng hoàn hảo mọi yếu tố để chủ nhân tận hưởng hiện tại và mở ra tương lai rực rỡ.
                  .news-pagination
      section.panel.section-top-developer.developer.js-bg#section-developer(aria-labelledby="developer-title")
        .group-central
          .inner
            .group-bg
              canvas.developer-wave(data-wave-src=imgPC + 'developer-wave.svg' aria-hidden="true")
              .developer-content
                h2.title-common-primary.js-title#developer-title Đối tác
                .developer-principals.js-title
                  .developer-principal
                    h3 Phát triển dự án
                    img.developer-conasi(src=path + '/resources/images/overview/partner-conasi.png' alt="Conasi" loading="eager")
                  .developer-principal
                    h3 Chủ đầu tư
                    img.developer-tnt(src=path + '/resources/images/overview/partner-tnt.png' alt="TNT Homes Quy Nhơn" loading="eager")
                section.developer-partners.js-title(aria-labelledby="developer-strategic-title")
                  h3#developer-strategic-title Đối tác chiến lược
                  .developer-divider(aria-hidden="true")
                    span ✦
                  .developer-partner-logos.swiper
                    .swiper-wrapper
                      .swiper-slide
                        img.is-edge(src=path + '/resources/images/overview/partner-edge.png' alt="EDGE" loading="eager")
                      .swiper-slide
                        img.is-savills(src=path + '/resources/images/overview/partner-savills.png' alt="Savills" loading="eager")
                      .swiper-slide
                        img.is-lumiere(src=path + '/resources/images/overview/partner-lumiere.png' alt="Lumière Style Hotel Resort" loading="eager")
                      .swiper-slide
                        img.developer-bank(src=path + '/resources/images/overview/partner-edge.png' alt="Ảnh tạm logo MB Bank" loading="eager")
                section.developer-distributors.js-title(aria-labelledby="developer-distributors-title")
                  h3#developer-distributors-title Đại lý phân phối
                  .developer-divider(aria-hidden="true")
                    span ✦
                  .developer-distributor-slider
                    button.developer-distributor-arrow.is-prev(type="button" aria-label="Đại lý trước")
                      img(src=imgPC + 'developer-slider-arrow.svg' width="45" height="45" alt="")
