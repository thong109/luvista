extends ../_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn | Giới thiệu'
  - var path = '..'
  - var page = 'overview'
  - var imgPC = path + '/resources/images/overview/'
  - var imgSP = path + '/resources/images/overview/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  main.home
    .slider-stage
      .panel.section-overview-keyvisual#section-home(aria-label="LUVISTA Quy Nhơn – Không gian sống bên hồ bơi" data-transition="simple")
        .group-central
          .inner
            .group-bg
              img.keyvisual-photo(src=imgPC + 'keyvisual-pool.png' width="1920" height="1080" alt="Hồ bơi và cảnh quan giữa các tòa căn hộ LUVISTA Quy Nhơn" loading="eager" fetchpriority="high" decoding="async")
              img.keyvisual-star(src=imgPC + 'partner-title-star.svg' width="30" height="30" alt="" aria-hidden="true")
              a.keyvisual-scroll(href="#section-overview" aria-label="Xem tổng quan dự án")
                img(src=imgPC + 'keyvisual-scroll.svg' width="74" height="74" alt="" aria-hidden="true")
      section.panel.section-overview.overview#section-overview(aria-labelledby="overview-title" data-transition="simple")
        .group-central
          .inner
            .group-bg
              img.overview-wave.is-bottom(src=imgPC + 'wave-bottom.svg' width="2732" height="617" alt="" aria-hidden="true")
              figure.overview-photo
                img.photo-image(src=imgPC + 'photo.png' width="1934" height="1080" alt="Phối cảnh tòa tháp và cảnh quan dự án LUVISTA" loading="eager" decoding="async")
              img.overview-wave.is-top(src=imgPC + 'wave-top.svg' width="2202" height="498" alt="" aria-hidden="true")
              img.overview-star.is-large(src=imgPC + 'star.svg' width="65" height="65" alt="" aria-hidden="true")
              img.overview-star.is-medium(src=imgPC + 'star.svg' width="36" height="36" alt="" aria-hidden="true")
              img.overview-star.is-small(src=imgPC + 'star.svg' width="27" height="27" alt="" aria-hidden="true")
              .overview-content
                h1.title-common-primary.is-left.is-gold.hero-title.js-title Giới thiệu
                h2.overview-subtitle.hero-sub.js-title Tổng quan về dự án
                dl.overview-location.hero-sub.js-title
                  dt Vị trí:
                  dd Đường Chế Lan Viên, Phường Quy Nhơn Nam, Tỉnh Gia Lai
                - var facts = [{label: 'Quy mô:', value: '8.3 ha'}, {label: 'Số tòa tháp:', value: '5 tòa'}, {label: 'Chiều cao:', value: '21 tầng, 1 tầng hầm'}, {label: 'Cơ cấu sản phẩm:', value: '1,596 căn hộ + 34 shophouse'}, {label: 'Mật độ xây dựng:', value: '50%'}, {label: 'Hình thức sở hữu:', value: 'Sở hữu lâu dài'}]
                dl.overview-facts.hero-sub.js-title
                  each fact in facts
                    dt= fact.label
                    dd= fact.value
                  dt Kết nối thuận lợi:
                  dd.is-note Trường học, bệnh viện, siêu thị, chợ... trong phạm vi di chuyển 10 phút; 30 phút tới sân bay Phù Cát, khu du lịch Kỳ Co – Eo Gió;...
                  dt Tiện ích nội khu:
                  dd.is-note Công viên, hồ bơi, đường dạo bộ, khu vui chơi trẻ em, trường mẫu giáo, sân chơi, clubhouse, quảng trường,...
      section.panel.section-overview-scale#section-scale(aria-labelledby="scale-title" data-transition="simple")
        .group-central
          .inner
            .group-bg
              img.scale-glow(src=imgPC + 'scale-glow.svg' width="1380" height="1380" alt="" aria-hidden="true")
              figure.scale-photo
                img(src=imgPC + 'scale-photo.png' width="1920" height="1080" alt="Kiến trúc các tòa tháp và phố thương mại LUVISTA Quy Nhơn" loading="eager" decoding="async")
              img.scale-wave(src=imgPC + 'scale-wave.svg' width="2804" height="634" alt="" aria-hidden="true")
              .scale-content
                h2.title-common-primary.hero-title.js-title.is-gold.is-left Quy mô, ý tưởng thiết kế
                h3.scale-subtitle.hero-sub.js-title LUVISTA Quy Nhơn - Kiến trúc xây dựng để trường tồn
                .scale-copy.hero-sub.js-title
                  p Những công trình trường tồn qua thế kỷ đều có một điểm chung - vật liệu địa phương, được chọn lọc kỹ lưỡng và sử dụng đúng cách.
                  p Khối đế ốp đá granit vàng Bình Định - hàng triệu năm tuổi, khai thác ngay trên mảnh đất Bình Định. Cứng vượt thời gian, không phai màu, không cần bảo trì - thế hệ kế thừa sẽ chạm vào đúng nguyên vẹn như ngày hoàn thiện đầu tiên.
                  p Năm tháp khoác gạch thẻ đỏ nung - vật liệu đã đi qua hàng thế kỷ kiến trúc Việt Nam, từ Hội An, Huế đến Bình Định. Điều hòa nhiệt tự nhiên, góp phần đạt chuẩn EDGE quốc tế. Sắc đỏ nâu ấm đổi sắc thái theo từng giờ - tạo silhouette không thể nhầm lẫn.
                  p Sở hữu Luvista không chỉ là quyết định của hôm nay - mà là di sản kiến trúc còn nguyên giá trị để trao lại cho thế hệ tiếp theo. Luvista Quy Nhơn không khấu hao theo thời gian - chúng tăng giá trị.
              .scale-materials
                figure.material-card
                  img.object-common(src=imgPC + 'scale-granite.png' width="1700" height="790" alt="Chi tiết đá granit vàng Bình Định ở khối đế" loading="lazy" decoding="async")
                  figcaption Đá Granit vàng Bình Định
                figure.material-card
                  img.object-common(src=imgPC + 'scale-brick.png' width="854" height="536" alt="Gạch thẻ đỏ trên mặt đứng tòa tháp" loading="lazy" decoding="async")
                  figcaption Gạch thẻ đỏ
              img.scale-star.is-large(src=imgPC + 'star.svg' width="64" height="64" alt="" aria-hidden="true")
              img.scale-star.is-medium(src=imgPC + 'star.svg' width="36" height="36" alt="" aria-hidden="true")
              img.scale-star.is-small(src=imgPC + 'star.svg' width="28" height="28" alt="" aria-hidden="true")
      section.panel.section-top-core-values.core-values#section-core-values(aria-labelledby="core-values-title")
        .group-central
          .inner
            .group-bg
              img.core-values-line.is-top(src=imgPC + 'values-line-01.png' width="880" height="161" alt="")
              img.core-values-line.is-bottom(src=imgPC + 'values-line-02.png' width="880" height="161" alt="")
              .wrapper
                h2.core-values-heading.js-title.hero-title
                  span 05
                  p.title-common-primary.is-gold Giá trị Trụ Cột
                - var coreValues = [{number: '01', text: 'Quỹ đất vàng <strong>cuối cùng</strong> của Phường nội đô Quy Nhơn Nam'}, {number: '02', text: 'Địa thế <strong>tựa sơn, hướng hải</strong> lưng tựa núi vững chãi, mặt hướng biển xanh đón trọn vượng khí.'}, {number: '03', text: 'Tiện ích cao cấp với Triết lý sống <strong>Urban Wellness</strong> cân bằng, viên mãn ngay giữa lòng đô thị'}, {number: '04', text: 'Pháp lý <strong>minh bạch – Sở hữu lâu dài – Sổ hồng</strong> từng căn'}, {number: '05', text: 'Chủ đầu tư có <strong>tiềm lực tài chính mạnh mẽ</strong>, cam kết về tiến độ và chất lượng vượt trội'}]
                .core-values-list.js-title.hero-sub
                  each item in coreValues
                    article.core-values-item
                      .core-values-number
                        img.object-common(src=imgPC + 'core-number-' + item.number + '.svg' width="179" height="129" alt!= item.number loading="eager")
                      p!= item.text
      section.panel.section-overview-partner.js-bg#section-partner(aria-labelledby="partner-title" data-transition="simple")
        .group-central
          .inner
            .group-bg
              img.partner-pattern(src=imgPC + 'partner-pattern.svg' alt="" aria-hidden="true")
              h2.title-common-primary.hero-title.js-title#partner-title Đối tác
              .partner-list
                article.partner-item.is-conasi.hero-sub.js-title
                  h3.partner-label Đơn vị phát triển
                  img.partner-logo(src=imgPC + 'partner-conasi.png' width="256" height="81" alt="Conasi" loading="lazy" decoding="async")
                article.partner-item.is-tnt.hero-sub.js-title
                  h3.partner-label Chủ đầu tư
                  img.partner-logo(src=imgPC + 'partner-tnt.png' width="201" height="206" alt="TNT Homes Quy Nhơn" loading="lazy" decoding="async")
                article.partner-item.is-edge.hero-sub.js-title
                  h3.partner-label Giải thưởng - chứng nhận
                  img.partner-logo(src=imgPC + 'partner-edge.png' width="254" height="105" alt="EDGE – Excellence in Design for Greater Efficiencies" loading="lazy" decoding="async")
                article.partner-item.is-savills.hero-sub.js-title
                  h3.partner-label
                    | Đơn vị vận hành toàn
                    br
                    | khu căn hộ
                  img.partner-logo(src=imgPC + 'partner-savills.png' width="145" height="145" alt="Savills" loading="lazy" decoding="async")
                article.partner-item.is-lumiere.hero-sub.js-title
                  h3.partner-label
                    | Đơn vị vận hành các căn
                    br
                    | hộ khai thác lưu trú
                  img.partner-logo(src=imgPC + 'partner-lumiere.png' width="243" height="130" alt="Lumière" loading="lazy" decoding="async")
              img.partner-star.is-large(src=imgPC + 'partner-star-large.svg' alt="" aria-hidden="true")
              img.partner-star.is-medium(src=imgPC + 'partner-star-medium.svg' alt="" aria-hidden="true")
              img.partner-star.is-small(src=imgPC + 'partner-star-small.svg' alt="" aria-hidden="true")
      section.panel.section-footer-common#section-contact(aria-labelledby="footer-consultation-title")
        .group-central
          .inner
            .group-bg
              .wrapper
                .section-footer-common-consultation
                  .section-footer-common-heading
                    h2.title-common-primary.is-gold Đăng ký tư vấn
                  p.section-footer-common-intro Quý khách vui lòng để lại thông tin, đội ngũ chuyên viên sẽ liên hệ tư vấn trong thời gian sớm nhất.
                  form.section-footer-common-form(action="" method="post")
                    label
                      input(type="text" name="name" required placeholder="Họ tên (*)")
                    label
                      input(type="email" name="email" placeholder="Email")
                    label
                      input(type="tel" name="phone" required placeholder="Số điện thoại (*)")
                    button.trans(type="submit") Liên hệ ngay
                .section-footer-common-contact
                  h2.title-common-primary.is-gold.no-icon Thông tin liên hệ
                  - var footerContacts = [{icon: 'footer-location.svg', title: 'Sales Office', detail: 'Tòa nhà Repubulic Plaza Cộng Hòa, 18E Cộng Hòa, Phường Tân Sơn Nhất, TP.HCM'}, {icon: 'footer-location.svg', title: 'Sales Gallery', detail: 'Đường Chế Lan Viên, Phường Quy Nhơn Nam, Tỉnh Gia Lai'}, {icon: 'footer-phone.svg', title: 'Hotline', detail: '0888 790 288'}, {icon: 'footer-email.svg', title: 'Email', detail: 'info@luvista.vn'}]
                  .section-footer-common-contact-list
                    each item in footerContacts
                      .section-footer-common-contact-item
                        img(src=imgCommonPC + item.icon width="34" height="34" alt="")
                        h3= item.title
                        p= item.detail
                  .section-footer-common-bottom
                    p © 2026 Luvista · Website by <a href="https://leaddigital.vn/" target="_blank" class="trans">Lead Digital</a>
                    .section-footer-common-social
                      a.trans(href="#" aria-label="Facebook")
                        img.object-common(src=imgCommonPC + 'footer-facebook.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Youtube")
                        img.object-common(src=imgCommonPC + 'footer-youtube.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Tiktok")
                        img.object-common(src=imgCommonPC + 'footer-tiktok.svg' width="34" height="34" alt="")
                      a.trans(href="#" aria-label="Zalo")
                        img.object-common(src=imgCommonPC + 'footer-zalo.svg' width="34" height="34" alt="")
                    .section-footer-common-policy
                      a.trans(href="#") Chính sách bảo mật thông tin cá nhân
                  p.section-footer-common-note Lưu ý: Chúng tôi đã nỗ lực và cẩn trọng để hoàn thiện tài liệu này. Tuy nhiên tài liệu chỉ dùng với mục đích tham khảo. Hình ảnh, sơ đồ kỹ thuật, bố trí nội ngoại thất hay thông tin mô tả về dự án chỉ nhằm mục đích minh họa, không phải là thông tin hiện thực hay cam kết pháp lý. Thông tin chính thức về dự án sẽ được căn cứ trên hợp đồng mua bán và các tài liệu được thỏa thuận, ký kết chính thức với khách hàng.
                a.section-footer-common-go-top.js-button-top.trans(href="#section-home" aria-label="Về đầu trang")
                  img.object-common.js-inline-svg(src=imgCommonPC + 'footer-go-top.svg' width="50" height="50" alt="" loading="eager")
