extends ../_base/_layout.pug
block vars
  - var metaTitle = 'LUVISTA Quy Nhơn | Thư viện'
  - var path = '..'
  - var page = 'gallery'
  - var imgPC = path + '/resources/images/gallery/'
  - var imgSP = path + '/resources/images/gallery/'
  - var imgCommonPC = path + '/resources/images/common/'
  - var imgCommonSP = path + '/resources/images/common/'

block content
  main.home
    .slider-stage
      section.panel.section-top-project-gallery.project-gallery(aria-labelledby="project-gallery-images")
        .group-central
          .inner
            .group-bg
              canvas.project-video-wave.is-top(data-wave-src=imgPC + 'video-wave-top.svg' aria-hidden="true")
              canvas.project-video-wave.is-bottom(data-wave-src=imgPC + 'video-wave-bottom.svg' aria-hidden="true")
              .wrapper
                h2.title-common-primary.is-gold.js-title Hình ảnh dự án
                - var projectGallery = [{url: imgPC + 'gallery-project-01.jpg', alt: 'Lối vào quảng trường chính', w: 1920, h: 1080}, {url: imgPC + 'gallery-project-02.jpg', alt: 'Hồ bơi lưng núi', w: 1920, h: 1080}]
                .project-gallery-slider.js-project-gallery.js-title.hero-sub
                  .swiper
                    .swiper-wrapper
                      each image, index in projectGallery.concat(projectGallery)
                        .swiper-slide
                          figure.project-gallery-item
                            button.project-gallery-image.js-slide-image(type="button" data-gallery=JSON.stringify(projectGallery) data-index=index % projectGallery.length data-title=image.alt aria-label='Xem ảnh: ' + image.alt)
                              img.object-common(src=image.url width=image.w height=image.h alt=image.alt loading="eager")
                            figcaption= image.alt
                  button.project-gallery-arrow.is-prev.trans(type="button" aria-label="Ảnh trước")
                    img(src=imgPC + 'gallery-arrow-prev.svg' width="51" height="34" alt="")
                  button.project-gallery-arrow.is-next.trans(type="button" aria-label="Ảnh tiếp theo")
                    img(src=imgPC + 'gallery-arrow-next.svg' width="51" height="34" alt="")
      section.panel.section-project-videos.project-videos(aria-labelledby="project-gallery-videos")
        .group-central
          .inner
            .group-bg
              canvas.project-video-wave.is-top(data-wave-src=imgPC + 'video-wave-top.svg' aria-hidden="true")
              canvas.project-video-wave.is-bottom(data-wave-src=imgPC + 'video-wave-bottom.svg' aria-hidden="true")
              .project-videos-content
                h2.title-common-primary.is-gold.js-title#project-gallery-videos Video dự án
                - var demoVideoUrl = 'https://www.youtube.com/embed/M7lc1UVf-VE'
                - var projectVideos = [{image: 'video-project.png', title: 'Video Dự án', url: demoVideoUrl}, {image: 'video-amenities.png', title: 'Giới thiệu tiện ích dự án', url: demoVideoUrl}, {image: 'video-overview.png', title: 'Tổng quan dự án', url: demoVideoUrl}]
                .project-video-slider.swiper.js-project-videos.js-title.hero-sub(aria-label="Video dự án" tabindex="0")
                  .swiper-wrapper
                    each video, index in projectVideos
                      .swiper-slide
                        figure.project-video-card
                          button.project-video-image.js-slide-video(type="button" class=index === 2 ? 'is-overview' : '' data-url=video.url data-title=video.title aria-label='Phát video: ' + video.title)
                            img(src=imgPC + video.image alt=video.title width="879" height="494")
                            span.project-video-play(aria-hidden="true")
                          figcaption= video.title
      section.panel.section-project-documents.project-documents(aria-labelledby="project-gallery-documents")
        .group-central
          .inner
            .group-bg
              canvas.project-video-wave.is-top(data-wave-src=imgPC + 'video-wave-top.svg' aria-hidden="true")
              canvas.project-video-wave.is-bottom(data-wave-src=imgPC + 'video-wave-bottom.svg' aria-hidden="true")
              .documents-content
                h2.title-common-primary.is-gold.js-title Tài liệu dự án
                - var projectDocuments = [{image: 'documents-flyer.png', title: 'Luvista Flyer'}, {image: 'documents-brochure.png', title: 'Brochue dự án'}, {image: 'documents-sales.png', title: 'Tài liệu bán hàng'}]
                .documents-slider.swiper.js-project-documents.js-title.hero-sub(aria-label="Tài liệu dự án" tabindex="0")
                  .swiper-wrapper
                    each document in projectDocuments.concat(projectDocuments)
                      .swiper-slide
                        a.document-card.trans(href="#" download="")
                          .document-cover
                            img(src=imgPC + document.image alt=document.title width="363" height="514")
                          figcaption= document.title
                .documents-pagination(aria-label="Trang tài liệu")
      include ../_parts/_footer-section.pug
